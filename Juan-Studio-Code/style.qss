/* =====================================================================
 * CORE STYLESHEET (style.qss)
 * Centralized global styles for dynamically generated UI components
 * ===================================================================== */

/* ----------------------------------------------------
 * UNIFIED TREE/TABLE WIDGET STYLING (QTreeWidget)
 * Applied to Lexical, Syntax, Semantic, Errors, and Symbol Table
 * ---------------------------------------------------- */
QTreeWidget {
    background-color: #1e1e1e;
    alternate-background-color: #252526;
    color: #d4d4d4;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 13px;
    border: none;
}

QHeaderView::section {
    background-color: #2d2d30;
    color: #ffffff;
    border: 1px solid #333333;
    padding: 6px;
    font-weight: bold;
}

QTreeWidget::item {
    padding: 4px;
    border-right: 1px solid #333333;
}

QTreeWidget::item:hover {
    background-color: #2a2d2e;
    color: #ffffff;
}

QTreeWidget::item:selected {
    background-color: #094771;
    color: #ffffff;
}
