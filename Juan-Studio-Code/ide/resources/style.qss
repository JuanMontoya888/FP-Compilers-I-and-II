/* =====================================================================
 * CORE STYLESHEET (style.qss)
 * Centralized global styles for dynamically generated UI components
 * ===================================================================== */

/* ----------------------------------------------------
 * UNIFIED TREE/TABLE WIDGET STYLING (QTreeWidget)
 * Applied to Lexical, Syntax, Semantic, Errors, and Symbol Table
 * ---------------------------------------------------- */
QTreeWidget {
    background-color: #1e1e1e;
    alternate-background-color: #252526;
    color: #d4d4d4;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 13px;
    border: none;
}

QHeaderView::section {
    background-color: #2d2d30;
    color: #ffffff;
    border: 1px solid #333333;
    padding: 6px;
    font-weight: bold;
}

QTreeWidget::item {
    padding: 4px;
    border-right: 1px solid #333333;
}

QTreeWidget::item:hover {
    background-color: #2a2d2e;
    color: #ffffff;
}

QTreeWidget::item:selected {
    background-color: #094771;
    color: #ffffff;
}

/* ----------------------------------------------------
 * VS CODE-STYLE SLIM SCROLLBARS
 * ---------------------------------------------------- */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: rgba(121, 121, 121, 0.4);
    border-radius: 3px;
    min-height: 24px;
    min-width: 24px;
    margin: 0px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: rgba(160, 160, 160, 0.7);
}

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
    width: 0px;
    height: 0px;
}

/* ----------------------------------------------------
 * TAB CLOSE BUTTON (TRANSPARENT IDLE, RED ON HOVER)
 * ---------------------------------------------------- */
QTabBar::close-button {
    background: transparent;
    border: none;
    border-radius: 3px;
    padding: 2px;
}

QTabBar::close-button:hover {
    background-color: #e81123;
}
